PORT=5095

# MongoDB
MONGODB_SECURE_URI=mongodb://127.0.0.1:27025/plexivia_secure_db
MONGODB_OPERATIONS_URI=mongodb://127.0.0.1:27025/plexivia_operations_db

# JWT (required, long random values, must differ)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated extra CORS origins (defaults in server.ts are always allowed)
CORS_ORIGINS=

# Super admin account (seeded on startup if missing)
ADMIN_EMAIL=
# Initial password for the super admin, applied only if that admin has no password yet
ADMIN_INITIAL_PASSWORD=

# Primary SMTP (required for sending mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plexivia Support" <support@plexihub.space>

# Optional fallback SMTP
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
SMTP_FALLBACK_FROM=
