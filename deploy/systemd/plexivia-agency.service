[Unit]
Description=Plexivia Agency Service (Port 5003)
After=network.target mongodb.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/plexivia/services/agency-service
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5003
Environment=AGENCY_SERVICE_PORT=5003
Environment=MONGODB_OPERATIONS_URI=mongodb://127.0.0.1:27017/plexivia_operations_db

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
