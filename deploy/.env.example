# Docker stack settings. Copy to deploy/.env and fill in the values.
# Compose reads this file for ${...} substitution and passes it to the backend container.

# MongoDB root password (letters, digits, - _ . ~ only, it is embedded in the connection URI).
# Only applied when the mongo_data volume is first created.
MONGO_ROOT_PASSWORD=

# Host ports
ADMIN_HOST_PORT=8010
BACKEND_HOST_PORT=5095
MONGO_HOST_PORT=27025

# Admin build args. Leave empty so the dashboard calls the same origin (nginx proxies /api to the backend).
VITE_API_BASE_URL=
VITE_WS_URL=

# ---- Backend (see backend/.env.example for details) ----
# JWT (required, long random values, must differ)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated extra CORS origins, e.g. https://admin.plexivia.com
CORS_ORIGINS=

ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Wrap values that contain double quotes in single quotes
SMTP_FROM='"Plexivia Support" <support@plexihub.space>'

SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
SMTP_FALLBACK_FROM=

IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_SYNC_ENABLED=true
WEBMAIL_USER=
WEBMAIL_PASS=
WEBMAIL_FORWARD_TO=

CONTROL_PANEL_LINKS=

CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=plexivia-backups
R2_BACKUP_ENABLED=true
R2_BACKUP_CRON=0 3 * * *
R2_BACKUP_TIMEZONE=Asia/Dhaka
